# Generated by tools/make-release.py from the complete reviewed local source.
pkgname=budslink-spatial-companion
pkgver=@VERSION@
pkgrel=4
pkgdesc='BudsLink Spatial Companion: spatial audio, head tracking and TIDAL for Plasma'
arch=('any')
license=('AGPL-3.0-only' 'MIT')
provides=("spatial-workbench=$pkgver")
conflicts=('spatial-workbench')
depends=('python>=3.11' 'python-dbus-next' 'pipewire' 'pipewire-audio' 'wireplumber' 'bluez')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('dbus' 'nodejs' 'lua' 'python-numpy' 'swh-plugins' 'git')
optdepends=('mpv-omniphony: spatial media playback using the upstream orender decoder'
            'orender-spatial: pinned renderer with verified local-only OSC control'
            'harletty-bridge: Atmos format decoder bridge for orender'
            'sony-tracker-spatial>=1.0.0-2: timestamped absolute earbud HID orientation'
            'python-tidalapi: built-in TIDAL catalogue and playback client'
            'swh-plugins: output limiter for the optional headphone equalizer'
            'plasma-budslink-spatial-companion: native Companion tracking controls')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    /usr/bin/python -m build --wheel --no-isolation
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    luac -p wireplumber/scripts/spatial-live-guard.lua
    SPATIAL_TEST_DBUS=1 dbus-run-session -- /usr/bin/python -m unittest discover -s tests
}

_validate_python_layout() {
    local unexpected launcher shebang
    local modules=("$pkgdir"/usr/lib/python*/site-packages/spatial/__init__.py)
    unexpected=$(find "$pkgdir" -mindepth 1 -maxdepth 1 ! -name usr -print -quit)
    if [[ -n "$unexpected" || ! -d "$pkgdir/usr" || -L "$pkgdir/usr" ]]; then
        printf '%s\n' 'Core wheel must install entirely under /usr.' >&2
        return 1
    fi
    if [[ ${#modules[@]} != 1 || ! -f "${modules[0]}" ]]; then
        printf '%s\n' 'Core wheel is missing its system Python module.' >&2
        return 1
    fi
    for launcher in spatialctl budslink-spatial; do
        if [[ ! -f "$pkgdir/usr/bin/$launcher" || ! -x "$pkgdir/usr/bin/$launcher" ||
              -L "$pkgdir/usr/bin/$launcher" ]]; then
            printf 'Core wheel is missing an executable launcher: %s\n' "$launcher" >&2
            return 1
        fi
        IFS= read -r shebang < "$pkgdir/usr/bin/$launcher"
        if [[ "$shebang" != '#!/usr/bin/python' ]]; then
            printf 'Core launcher must use /usr/bin/python: %s\n' "$launcher" >&2
            return 1
        fi
    done
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    # A developer's active virtual environment must never become a package path
    # or a launcher interpreter. Check the staged payload before adding assets.
    /usr/bin/python -m installer --prefix=/usr --destdir="$pkgdir" dist/*.whl
    _validate_python_layout || return 1
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cp -r LICENSES "$pkgdir/usr/share/licenses/$pkgname/"
    install -Dm644 packaging/spatiald.service "$pkgdir/usr/lib/systemd/user/spatiald.service"
    install -Dm644 packaging/69-spatiald-trackers.rules "$pkgdir/usr/lib/udev/rules.d/69-spatiald-trackers.rules"
    install -Dm755 tools/diagnostics.py "$pkgdir/usr/bin/spatial-diagnostics"
    install -Dm755 tools/verify.py "$pkgdir/usr/bin/spatial-verify"
    install -Dm644 wireplumber/scripts/spatial-live-guard.lua \
        "$pkgdir/usr/share/wireplumber/scripts/spatial-live-guard.lua"
    install -Dm644 wireplumber/wireplumber.conf.d/90-spatial-live-guard.conf \
        "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/90-spatial-live-guard.conf"
    install -d "$pkgdir/usr/share/doc/$pkgname" "$pkgdir/usr/share/$pkgname"
    cp -r docs README.md STATUS.md "$pkgdir/usr/share/doc/$pkgname/"
    cp -r config "$pkgdir/usr/share/$pkgname/"
}
