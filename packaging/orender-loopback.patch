 /// Timeout after which a registered client (one that must heartbeat) is considered dead.
 const CLIENT_TIMEOUT: Duration = Duration::from_secs(15);
+
+// Optional bind policy for hosts that keep their control API on localhost.
+// Unset preserves upstream behavior; an invalid value fails without falling
+// back to a wildcard address. This also applies to the embedded liborender host.
+fn parse_osc_bind_ip(value: Option<std::ffi::OsString>) -> std::io::Result<std::net::Ipv4Addr> {
+    match value {
+        None => Ok(std::net::Ipv4Addr::UNSPECIFIED),
+        Some(value) => value.to_str()
+            .and_then(|value| value.parse::<std::net::Ipv4Addr>().ok())
+            .ok_or_else(|| std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "OMNIPHONY_OSC_BIND must be an IPv4 address",
+            )),
+    }
+}
+
+fn bind_osc_socket(port: u16) -> std::io::Result<UdpSocket> {
+    UdpSocket::bind((parse_osc_bind_ip(std::env::var_os("OMNIPHONY_OSC_BIND"))?, port))
+}
 
