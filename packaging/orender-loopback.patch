+    #[test]
+    fn spatial_loopback_bind_policy_accepts_only_numeric_ipv4() {
+        use std::net::Ipv4Addr;
+        assert_eq!(parse_osc_bind_ip(None).unwrap(), Ipv4Addr::UNSPECIFIED);
+        assert_eq!(parse_osc_bind_ip(Some("127.0.0.1".into())).unwrap(), Ipv4Addr::LOCALHOST);
+        assert_eq!(parse_osc_bind_ip(Some("0.0.0.0".into())).unwrap(), Ipv4Addr::UNSPECIFIED);
+        for invalid in ["", "localhost", "127.0.0.1:9000", "::1", "300.0.0.1"] {
+            assert_eq!(parse_osc_bind_ip(Some(invalid.into())).unwrap_err().kind(),
+                       std::io::ErrorKind::InvalidInput);
+        }
+    }
+
+    #[test]
