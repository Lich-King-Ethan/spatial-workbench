+// Stable byte order and no struct padding: SPT1 + host capture ns + sequence + HID.
+static void send_timestamped_report(int sock, struct sockaddr_in *addr,
+                                    uint64_t captured_ns, uint64_t sequence,
+                                    const uint8_t *report) {
+    uint8_t packet[34] = {'S', 'P', 'T', '1'};
+    for (int byte = 0; byte < 8; byte++) {
+        packet[4 + byte] = (uint8_t)(captured_ns >> (8 * byte));
+        packet[12 + byte] = (uint8_t)(sequence >> (8 * byte));
+    }
+    memcpy(packet + 20, report, 14);
+    sendto(sock, packet, sizeof(packet), 0, (struct sockaddr*)addr, sizeof(*addr));
+}
