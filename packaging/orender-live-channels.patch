+    // Parse the exact serialized pod passed to Stream::connect. This fails for
+    // the upstream format even when its audio.position property lists 8 names.
+    #[test]
+    fn spatial_live_channels_format_pod_has_positioned_seven_one_layout() {
+        let values = build_live_input_format_pod(48_000, 8).unwrap();
+        let pod = Pod::from_bytes(&values).unwrap();
+        let mut parsed = spa::param::audio::AudioInfoRaw::new();
+        parsed.parse(pod).unwrap();
+
+        assert_eq!(parsed.format(), spa::param::audio::AudioFormat::F32LE);
+        assert_eq!(parsed.rate(), 48_000);
+        assert_eq!(parsed.channels(), 8);
+        assert!(!parsed.flags().contains(spa::param::audio::AudioInfoRawFlags::UNPOSITIONED));
+        assert_eq!(&parsed.position()[..8], &[
+            spa::sys::SPA_AUDIO_CHANNEL_FL,
+            spa::sys::SPA_AUDIO_CHANNEL_FR,
+            spa::sys::SPA_AUDIO_CHANNEL_FC,
+            spa::sys::SPA_AUDIO_CHANNEL_LFE,
+            spa::sys::SPA_AUDIO_CHANNEL_SL,
+            spa::sys::SPA_AUDIO_CHANNEL_SR,
+            spa::sys::SPA_AUDIO_CHANNEL_RL,
+            spa::sys::SPA_AUDIO_CHANNEL_RR,
+        ]);
+    }
+
+    #[test]
