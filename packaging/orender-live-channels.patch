+            assert_eq!(frame.channel_labels.as_slice(), labels.as_slice());
+            assert_eq!(&frame.channel_labels[lane], label);
+            for index in 0..8 {
+                assert_eq!(frame.pcm[index], if index == lane { I32_PCM_FULL_SCALE / 2 } else { 0 });
+            }
+        }
+    }
